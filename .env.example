# Copy to .env for local development. In production these are provided by
# compose.yml / the container environment instead.

DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/home_manager

# openssl rand -hex 32
SESSION_SECRET=

# my-home-backend (NestJS API) — sections migrated off Drizzle call this.
# Not the public URL; server-to-server, so the Docker service name in
# compose, 127.0.0.1:3000 for local dev.
API_URL=http://127.0.0.1:3000

# Must be the exact same value as my-home-backend's JWT_SECRET. The login
# action gets its token from POST /auth/login and stores it in this app's
# own httpOnly cookie; requireUser() then verifies it locally (no network
# round trip on every page load) rather than calling the API back — see
# my-home-backend/CLAUDE.md's Authentication section for the token shape.
JWT_SECRET=

# Real accounts now (see CLAUDE.md's Authentication section) — there's no
# single shared password to set here. Users are rows in the `users` table
# (email + argon2id password_hash); create/update them directly, or via
# `npm run db:seed` for local dev fixtures (mia@example.com / sam@example.com,
# password "devpassword" — never use those on a real deployment).

# Production only (compose.prod.yml) — the domain Caddy requests a
# Let's Encrypt certificate for.
# DOMAIN=home.example.com

# Base URL used to build links in emails (invite, account activation).
APP_URL=http://localhost:5173

# SMTP for outgoing mail (invites, account activation). If SMTP_HOST is
# unset, emails are logged to the console instead of sent — fine for local
# dev, required in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="Hearth <no-reply@example.com>"

# Production only (scripts/backup.sh) — an rclone remote (see `rclone
# config`) that pg_dump backups get copied to. Backups fail loudly if this
# isn't set, rather than silently only writing to local disk.
# BACKUP_REMOTE=b2:home-manager-backups
