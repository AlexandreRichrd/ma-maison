# Copy to .env for local development. In production these are provided by
# compose.yml / the container environment instead.

DATABASE_URL=postgres://home_manager:home_manager@127.0.0.1:5432/home_manager

# openssl rand -hex 32
SESSION_SECRET=

# Household login password. Generate with:
#   node -e "const c=require('crypto');const s=c.randomBytes(16).toString('hex');console.log('AUTH_PASSWORD_HASH='+s+':'+c.scryptSync(process.argv[1],s,64).toString('hex'))" "your-password-here"
AUTH_PASSWORD_HASH=
